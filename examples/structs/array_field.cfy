struct Buffer {
    data: [int; 3],
    len: int,
}

fn main() {
    let mut buf = Buffer {
        data: [10, 20, 30],
        len: 3,
    };

    buf.data[1] = 99;

    let mut sum = 0;
    let mut i = 0;
    while i < buf.len {
        sum = sum + buf.data[i];
        i = i + 1;
    }

    $syscall(1, sum, 0, 0, 0, 0, 0); // exit 10+99+30 = 139
}
